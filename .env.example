# 可选：Codex CLI 可执行文件绝对路径；不设置时自动检测本机已有运行时。
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=

# PostgreSQL 配置
POSTGRES_DB=sharescope
POSTGRES_USER=sharescope
PGPASSWORD=replace-with-a-strong-random-password

# 模型配置密钥的 AES-256-GCM 加密密钥：64 位十六进制字符串。
# 可用 openssl rand -hex 32 生成；丢失后已保存的 API Key 将无法解密。
MODEL_CONFIG_ENCRYPTION_KEY=
